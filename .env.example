# ---------------------------------------------------------------------------
# The W Gym & Sauna — environment
# Copy to `.env` and fill in. Nothing here is committed.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, sitemap, OG images, Stripe
# redirects and magic-link callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database --------------------------------------------------------------
# Local development: `npx prisma dev --name wgym --detach` prints this URL.
# Production: a Neon / Supabase / Prisma Postgres connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Maximum pooled connections. Booking creation holds one for the length of a
# serialisable transaction, so this must stay under the database's own limit.
DATABASE_POOL_MAX="10"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Only needed if the deployment URL cannot be inferred (most hosts infer it).
AUTH_URL=""

# --- Resend (transactional email) -----------------------------------------
# Without a key the app logs emails to the console instead of sending, so the
# whole flow still works locally.
RESEND_API_KEY=""
EMAIL_FROM="The W Gym & Sauna <hello@example.com>"

# --- Stripe ----------------------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""

# --- Seeding ---------------------------------------------------------------
# The first account promoted to OWNER when `npm run db:seed` runs.
SEED_OWNER_EMAIL="owner@example.com"
