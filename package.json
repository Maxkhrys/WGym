{
  "name": "wgym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:dev": "prisma dev --name wgym",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "check:tz": "tsx scripts/check-timezone.ts",
    "check:booking": "tsx --conditions=react-server scripts/check-double-booking.ts",
    "check:concurrency": "tsx --conditions=react-server scripts/check-concurrency.ts",
    "check:routes": "node scripts/check-routes.mjs",
    "check:guards": "tsx --conditions=react-server scripts/check-auth-guards.ts",
    "check:webhook": "tsx --conditions=react-server scripts/check-stripe-webhook.ts",
    "check": "npm run typecheck && npm run lint && npm run check:tz",
    "check:db": "npm run check:concurrency && npm run check:booking"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
